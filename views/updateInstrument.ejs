<!doctype html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<title>Update Instrument</title>
</head>
<body>
<%- include("partials/error.ejs", errors)%>
    <form action="/instrument/update/<%= instrumentName%>" method="post">
        <input type="text" name="instrumentName">
        <select name="categoryName">
<% categories.forEach(category => {%>
<option value="<%= category.category%>"><%= category.category%></option>
<% }); %>
</select>
        <button>Update Instrument</button>
    </form>
    <%= updated ? "Instrument updated successfully" : ""%>
    <a href="/">back home</a>
</body>
</html>
