<!doctype html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<title>All <%= categoryName%> instruments</title>
</head>
<body>
<%- include("partials/error.ejs", {errors: instruments})%>
<% if(instruments.length === 0) {%>
<p>This instrument does not have any instruments yet, add some!</p>
<% }%>
<ul>
<% instruments.forEach(row => {%>
<li><%= row.instrument%> <a href="/instrument/delete/<%= row.instrument%>"> | Delete</a> <a href="/instrument/update/<%= row.instrument%>"> | Update</a></li>
<% }); %>
</ul>
<a href="/instrument/new?category=<%=categoryName%>">Add an instrument to this category</a>
<a href="/">back home</a>
</body>
</html>
